# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored — never commit real secrets.

# --- Core ---
# Your real domain, e.g. https://design.yourcompany.com
PENPOT_PUBLIC_URI=

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
PENPOT_SECRET_KEY=

# Pin the image tag deployed by docker-compose.yaml (defaults to 2.16 if unset).
# PENPOT_VERSION=2.16

# --- Postgres ---
# Used by both penpot-postgres and penpot-backend overrides.
POSTGRES_PASSWORD=

# --- SMTP (Resend) ---
# https://resend.com/api-keys
RESEND_API_KEY=
SMTP_FROM_EMAIL=no-reply@yourcompany.com
